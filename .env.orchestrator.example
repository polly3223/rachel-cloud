# Rachel Cloud Container Orchestrator - Environment Variables
# Copy this to .env.orchestrator and fill in your values:
#   cp .env.orchestrator.example .env.orchestrator
#   chmod 600 .env.orchestrator

# Required: API key for authenticating control plane requests
ORCHESTRATOR_API_KEY=

# Optional overrides (defaults shown)
# ORCHESTRATOR_PORT=9998
# RACHEL_IMAGE=rachel8:latest
# DOCKER_SOCKET=/var/run/docker.sock
# DOCKER_NETWORK=rachel-net
# PROXY_URL=http://host.docker.internal:9999
# GROQ_API_KEY=
# LOG_LEVEL=info

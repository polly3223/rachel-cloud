# Rachel Cloud LLM Proxy - Environment Variables
# Copy this to .env.proxy and fill in your values:
#   cp .env.proxy.example .env.proxy
#   chmod 600 .env.proxy

# Required: Z.ai API key (never commit this!)
ZAI_API_KEY=

# Optional overrides (defaults shown)
# PROXY_PORT=9999
# ZAI_UPSTREAM_URL=https://api.z.ai/api/anthropic
# LOG_LEVEL=info
# PROXY_DB_PATH=data/proxy.db
